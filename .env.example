# Default provider when no saved provider exists.
DEFAULT_PROVIDER=local

# Required to protect /admin. Use a long random password.
ADMIN_PASSWORD=change-this-to-a-long-random-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Only required when you switch the admin panel to OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional persistent global provider storage for serverless production.
# If omitted, provider is stored in data/provider.json (works locally / persistent servers).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

MAX_IMAGE_BYTES=10485760
